{
  "name": "@knowledge-bus/pi",
  "version": "0.5.0",
  "private": true,
  "description": "Knowledge Bus workflows for Pi",
  "license": "MIT",
  "keywords": ["pi-package"],
  "pi": {"skills": ["./skills"]},
  "files": ["skills/", "references/", "runtime/", "LICENSE"],
  "scripts": {
    "build": "uv run --locked --project ../../.. python ../../../tools/plugin/plugin.py build pi",
    "check": "uv run --locked --project ../../.. python ../../../tools/plugin/plugin.py check pi",
    "prepack": "node -e \"throw new Error('Use just plugin-build pi to pack the complete package.')\""
  }
}
