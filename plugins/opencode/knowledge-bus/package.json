{
  "name": "@knowledge-bus/opencode",
  "version": "0.5.0",
  "private": true,
  "description": "Knowledge Bus workflows for OpenCode",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {".": "./index.js", "./server": "./index.js"},
  "files": ["index.js", "skills/", "references/", "runtime/", "LICENSE"],
  "scripts": {
    "build": "uv run --locked --project ../../.. python ../../../tools/plugin/plugin.py build opencode",
    "check": "uv run --locked --project ../../.. python ../../../tools/plugin/plugin.py check opencode",
    "prepack": "node -e \"throw new Error('Use just plugin-build opencode to pack the complete package.')\""
  }
}
