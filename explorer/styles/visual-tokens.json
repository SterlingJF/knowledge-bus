        "kind": "length",
        "value": "11px",
        "role": "Caption — stats, legend keys, metadata and code snippets"
      },
      "body-sm": {
        "kind": "length",
        "value": "12px",
        "role": "Small body — card subtitles, hints and field labels"
      },
      "button": {
        "kind": "length",
        "value": "12px",
        "role": "Control label — dock, view tabs, chips and segmented buttons"
