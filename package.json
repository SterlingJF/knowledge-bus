{
  "name": "knowledge-bus-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.1",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "markdownlint-cli2": "0.23.2",
    "oxc-parser": "0.147.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "scripts": {
    "prepare": "husky",
    "check:fast": "node tools/quality/run.mjs check:format lint check:protocol check:skills check:explorer",
    "check:staged": "node tools/quality/snapshot.mjs staged",
    "check:push": "node tools/quality/snapshot.mjs push",
    "install:frozen": "pnpm install --frozen-lockfile",
    "install:unlock": "pnpm install --no-frozen-lockfile",
    "check": "node tools/quality/run.mjs check:fast check:plugins test test:explorer",
    "check:format": "pnpm run check:format:python",
    "check:format:python": "uv run --locked ruff format --check .",
    "lint": "node tools/quality/run.mjs lint:python lint:markdown",
    "lint:python": "uv run --locked ruff check .",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\"",
    "format": "node tools/quality/run.mjs format:python format:explorer",
    "format:python": "uv run --locked ruff format .",
    "fix": "node tools/quality/run.mjs fix:python fix:markdown format lint",
    "fix:python": "uv run --locked ruff check --fix .",
    "fix:markdown": "markdownlint-cli2 --fix \"**/*.md\"",
    "check:protocol": "uv run --locked kbp --self-check",
    "check:skills": "uv run --locked python tools/plugin/skills.py --check",
    "build:plugins": "uv run --locked python tools/plugin/plugin.py build all",
    "check:plugins": "uv run --locked python tools/plugin/plugin.py check all",
    "test": "node --test tools/quality/*.test.mjs tools/explorer/*.test.mjs && uv run --locked pytest -q",
    "build:explorer": "node tools/explorer/build.mjs",
    "render:explorer": "node tools/explorer/render.mjs --input universes/product-development/universe.kbp.yaml --guidance universes/product-development/type-guidance.kbp.yaml --marks universes/product-development/marks.explorer.yaml --html dist/explorer/product-development.html --svg dist/explorer/product-development.svg",
    "render:explorer:release-example": "node tools/explorer/release-example.mjs --input universes/product-development/universe.kbp.yaml --universe product-development --output dist/explorer-release/product-development",
    "check:explorer:types": "tsc -p explorer/tsconfig.json && tsc -p explorer/tsconfig.test.json",
    "check:explorer:tokens": "node tools/explorer/check-tokens.mjs",
    "check:component-layers": "tsx tools/explorer/check-layers.ts",
    "check:explorer": "node tools/quality/run.mjs check:explorer:format check:explorer:source check:explorer:bundle check:explorer:types check:explorer:tokens check:component-layers",
    "check:explorer:bundle": "node tools/explorer/check-bundle.mjs",
    "test:explorer:unit": "tsx --tsconfig explorer/tsconfig.test.json --test explorer/test/unit/*.test.ts",
    "test:explorer:browser": "node tools/quality/run.mjs test:explorer:browser:parallel test:explorer:browser:exclusive",
    "test:explorer:browser:parallel": "KB_EXPLORER_LANE=parallel playwright test --config tools/explorer/playwright.config.ts",
    "test:explorer:browser:exclusive": "KB_EXPLORER_LANE=exclusive playwright test --config tools/explorer/playwright.config.ts",
    "test:explorer:adapter": "uv run --locked python -m unittest discover -s explorer/test/adapter",
    "check:explorer:artifacts": "node tools/explorer/check-artifacts.mjs dist/explorer",
    "capture:explorer:step": "node tools/explorer/shots.mjs --out dist/explorer-shots/step --tier step",
    "compare:explorer:shots": "node tools/explorer/shots.mjs --compare",
    "format:explorer": "prettier --write \"explorer/**/*.{ts,css,json}\" \"tools/explorer/**/*.{ts,mjs,json}\"",
    "check:explorer:format": "prettier --check \"explorer/**/*.{ts,css,json}\" \"tools/explorer/**/*.{ts,mjs,json}\"",
    "generate:explorer:tokens": "node tools/explorer/generate-tokens.mjs",
    "check:explorer:source": "node tools/explorer/check-source.mjs",
    "test:explorer": "node tools/quality/run.mjs test:explorer:unit test:explorer:adapter build:explorer render:explorer test:explorer:browser check:explorer:artifacts"
  }
}
