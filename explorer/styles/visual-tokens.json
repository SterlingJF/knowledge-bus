      },
      "dimmed": {
        "kind": "number",
        "value": ".13",
        "role": "Opacity of the contents of a dimmed card"
      },
      "hushed": {
        "kind": "number",
        "value": ".5",
        "role": "Opacity of the contents of a hushed card"
