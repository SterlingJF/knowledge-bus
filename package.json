{
  "name": "knowledge-bus-workspace",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6"
  },
  "scripts": {
    "prepare": "husky",
    "check:fast": "node tools/quality/run.mjs check:format lint check:protocol check:skills",
    "check:staged": "node tools/quality/snapshot.mjs staged",
    "check:push": "node tools/quality/snapshot.mjs push",
    "install:frozen": "pnpm install --frozen-lockfile",
    "install:unlock": "pnpm install --no-frozen-lockfile",
    "check": "node tools/quality/run.mjs check:fast check:plugins test",
    "check:format": "pnpm run check:format:python",
    "check:format:python": "uv run --locked ruff format --check .",
    "lint": "node tools/quality/run.mjs lint:python lint:markdown",
    "lint:python": "uv run --locked ruff check .",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\"",
    "format": "pnpm run format:python",
    "format:python": "uv run --locked ruff format .",
    "fix": "node tools/quality/run.mjs fix:python fix:markdown format lint",
    "fix:python": "uv run --locked ruff check --fix .",
    "fix:markdown": "markdownlint-cli2 --fix \"**/*.md\"",
    "check:protocol": "uv run --locked kbp --self-check",
    "check:skills": "uv run --locked python tools/plugin/skills.py --check",
    "build:plugins": "uv run --locked python tools/plugin/plugin.py build all",
    "check:plugins": "uv run --locked python tools/plugin/plugin.py check all",
    "test": "node --test tools/quality/*.test.mjs && uv run --locked pytest -q"
  }
}
